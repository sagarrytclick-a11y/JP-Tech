# Admin panel
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# Where enquiry notifications are delivered (comma-separated for multiple)
NOTIFICATION_EMAIL=info@jptechnology.com

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/jptechnologies

# Email notifications (nodemailer / SMTP)
# Gmail requires an App Password when 2-Step Verification is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@jptechnology.com
SMTP_PASS=your-app-password
SMTP_FROM="JP Technology <info@jptechnology.com>"
